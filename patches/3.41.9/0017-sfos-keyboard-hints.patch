+bool GetBool(const rapidjson::Value& object, const char* key, bool fallback) {
+  auto member = object.FindMember(key);
+  if (member == object.MemberEnd() || !member->value.IsBool()) {
+    return fallback;
+  }
+  return member->value.GetBool();
+}
