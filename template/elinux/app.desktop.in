# Copy into elinux/ and adjust Name / Exec / X-Sailjail.

[Desktop Entry]
Type=Application
Name=My Flutter App
Comment=A Flutter app on Sailfish OS
Icon=icon-m-developer-mode
Exec=my-flutter-app
X-Nemo-Application-Type=generic

# Sailjail sandbox. List the permissions the app needs, e.g.
# Permissions=Internet;Pictures (see sailfishos/sailjail-permissions).
# The app can write to ~/.local/share, ~/.config and ~/.cache under
# <OrganizationName>/<ApplicationName>.
[X-Sailjail]
Permissions=
OrganizationName=org.example
ApplicationName=MyFlutterApp
